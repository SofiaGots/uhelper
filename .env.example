# Environment
ENVIRONMENT=development  # development | production | testing

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_PROXY=socks5://127.0.0.1:1080  # раскомментируйте, если Telegram API заблокирован

# OpenAI-compatible API Configuration
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1  # или ваш базовый URL
OPENAI_PROJECT_ID=your_openai_project_id_here  # опционально
OPENAI_MODEL=gpt-3.5-turbo

# Database / Cache
DATABASE_URL=sqlite:///uhelper.db
REDIS_URL=redis://localhost:6379/0  # опционально, если используете rate limiting/кэш

# Network/timeouts
REQUEST_TIMEOUT_SECONDS=15

# Rate limiting
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60

# Retry / Circuit breaker
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30.0
